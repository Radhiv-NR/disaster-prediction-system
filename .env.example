# Copy this file to .env and replace placeholders with your own values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=disaster_user
DB_PASSWORD=change_me
DB_NAME=disaster_prediction_db

# Open-Meteo is free and does not require an API key.
WEATHER_PROVIDER=open_meteo
WEATHER_ENABLED=true

FLASK_HOST=127.0.0.1
FLASK_PORT=8000
FLASK_DEBUG=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SIMULATOR_ENABLED=true
LIVE_ALERTS_ENABLED=true

TTS_ENABLED=true
MACOS_NOTIFICATIONS_ENABLED=true
SMS_ENABLED=false
TELEGRAM_ENABLED=false
EMAIL_ENABLED=false
